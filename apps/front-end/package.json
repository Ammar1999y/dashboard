{
  "name": "@app/front-end",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "bun ../../scripts/require-bun.mjs",
    "predev": "bun scripts/build-icons.ts && bun scripts/copy-compression-worker.ts && bun scripts/build-editor-css.ts",
    "prebuild": "bun --bun scripts/generate-manifest.ts && bun scripts/build-icons.ts && bun scripts/copy-compression-worker.ts && bun scripts/build-editor-css.ts",
    "dev": "bun --bun  next dev",
    "predev:mock": "bun scripts/build-icons.ts && bun scripts/copy-compression-worker.ts && bun scripts/build-editor-css.ts",
    "dev:mock": "NEXT_PUBLIC_API_MOCKING=enabled bun --bun next dev  --webpack",
    "build": "NEXT_PUBLIC_API_MOCKING=enabled bun --bun next build",
    "start": "NEXT_PUBLIC_API_MOCKING=enabled bun --bun run next start -p 3123",
    "lint": "bun --bun tsc --noEmit && bun --bun eslint . --max-warnings 0 && bun run audit:css",
    "test": "bun test tests",
    "audit": "bun scripts/audit.ts",
    "audit:css": "bun scripts/css-support.ts --app",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "find:unused-files": "bunx knip",
    "scan:secrets": "mise exec -- gitleaks git . --redact --verbose --no-banner",
    "scan:sast": "mise exec -- semgrep scan --config=p/typescript --config=p/secrets --error --metrics=off"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "npm": "use bun (run: node ../../scripts/require-bun.mjs)",
    "yarn": "use bun (run: node ../../scripts/require-bun.mjs)",
    "pnpm": "use bun (run: node ../../scripts/require-bun.mjs)"
  },
  "browserslist": {
    "defaults": [
      "Chrome >= 88",
      "Safari >= 15",
      "defaults and fully supports es6-module and not dead"
    ],
    "css": [
      "Chrome >= 88",
      "Safari >= 15"
    ]
  },
  "dependencies": {
